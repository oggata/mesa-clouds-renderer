# サーバの設定。このファイルを .env にコピーして使う (.env は .gitignore 済み)。
#   起動: node server.js   /   npm start
#   ダッシュボード(Render等)や `FOO=1 node server.js` で渡した値のほうが優先される。

# ── YouTube ライブチャットから指示を受け取る ──────────────────────────────
YT_CHAT=1
YT_API_KEY=ここにAPIキー
YT_VIDEO_ID=ここに配信中の動画ID
# 動画IDの代わりにチャンネルIDを入れると、配信中の動画を自動で探す
# (search.list は 100 units と高いので、動画IDが分かるならそちらが安い)
#YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# 配信を立て直して動画IDが変わったとき、自動で次の配信を探す (既定で有効)。
#   YT_CHANNEL_ID を書いていなくても、YT_VIDEO_ID から投稿チャンネルを学習して探す。
#   見つけた動画IDは data/yt_live.json に保存されるので、再起動しても引き継ぐ。
#   状態確認: curl http://localhost:8080/yt   /  手動で探し直す: ?refind=1
#YT_AUTO_FIND=0          # 自動追従を切る
#YT_SCAN_RECENT=5        # アップロード一覧を何件見るか
#YT_SEARCH_MIN_SEC=120   # 探索の最短間隔 (秒)
#YT_ALLOW_SEARCH=0       # search.list (100 units) のフォールバックを使わない
#YT_SEARCH_MAX_PER_DAY=10
# 取り込み方式: auto (既定) = gRPC streamList を試し、駄目なら適応ポーリング
#   grpc / poll / stream を明示指定もできる
#YT_CHAT_MODE=auto
# gRPC の張り直し間隔(秒)と、1接続あたりの想定ユニット単価
#   Console を1時間見て消費が伸びないようなら UNIT_COST=0 にするとほぼ常時接続になる
#YT_GRPC_RECONNECT_SEC=2
#YT_GRPC_UNIT_COST=5
# 取得間隔(秒)。静かなときと、会話中の値。実際の間隔は残りの枠を見て自動で決まる
YT_CHAT_POLL_SEC=45      # 誰も喋っていないとき
YT_CHAT_POLL_FAST=8      # 直近に発言があったとき
#YT_CHAT_ACTIVE_SEC=120  # 何秒間 発言が無ければ「静か」とみなすか
# liveChat の単価は非公開。Console の実測が見積りより小さければ 1 にすると反応が速くなる
#YT_CHAT_UNIT_COST=5

# ── チャット指示の挙動 ────────────────────────────────────────────────────
CHAT_FOCUS_SEC=10         # 1回の指名で映す秒数
CHAT_COOLDOWN_SEC=12      # 次の指名を受け付けるまで
#CHAT_TOKEN=              # /chat を外に晒すなら合言葉を設定する
#VIEWER_MAX_FRAC=0.3      # 視聴者住民 (!join) は人口のこの割合まで
#CHAT_NG_WORDS=           # 住民名に使わせない語 (カンマ区切り)。配信に出るので必要なら設定

# ── YouTube へ配信する場合 ────────────────────────────────────────────────
#YT_STREAM_KEY=
# BGM。ディレクトリならその中の曲を順に、ファイルならその曲をループ。
#   ★ 公開配信なのでロイヤリティフリーの曲を使うこと (Content ID の対象になる)
#YT_MUSIC=./music
#YT_MUSIC_VOL=0.35        # 送出時の音量
#YT_MUSIC_SHUFFLE=0       # 名前順にする (既定はシャッフル)
#YT_MUSIC_REPEAT=200      # 一覧を何周ぶん書くか (尽きると配信が止まるので多めに)

# ── その他よく触るもの (docs/city-evolution-spec.md §8 / §11.6 に一覧) ────
#CITY_TEMPO=2             # 街の変化の速さ (建つ/なくなる頻度)。1=落ち着く 4=慌ただしい
#FOOT_HEALTH=0.01         # 人流が店の生死に効く強さ。0 で来客数だけで決まる
#ECON_SCALE=1             # 街の発展の速さ (小さいほど早い)
#START_SIZE=10            # 最初のフィールドの一辺
#NEED_ICONS=1             # 頭上の欲求アイコンを戻す

# 街の最大の一辺 (セル数)。実寸は GRID x CELL (CELL=2.0)。
#   ★ 変えると data/city_state.json を読めなくなり Day1 からやり直しになる。
#     広げる前に必ず退避すること。実測は docs/city-evolution-spec.md §19。
#GRID=45

# ── お金・仕事・犯罪 (economy.js) ──
#   失業 → 無一文 → 万引き/スリ → 店の売上減 → さらに失業、という環。
#ECON=0                   # 経済ごと無効
#CRIME=0                  # 犯罪だけ無効 (経済は動く)
#LIVING_COST=8            # 1日の固定支出。上げるほど街が荒れる
#WAGE=12                  # 1日の給料
#START_CASH=40            # 初期の手持ち
#JOB_SEARCH_DAYS=3        # 失業から再就職までの待ち
#SHOP_JOBS=2              # 店1軒が雇う人数
#CRIME_MIN=0.45           # 追い詰められ度がこれ未満なら誰も手を出さない
#POLICE=0                 # 警察を無効 (犯罪は起きるが誰も捕まらない)
#COP_SEE=9                # 警官が手配犯に気づく距離 (セル)
#POLICE_UNREST=0.03       # この不穏さを超えたら街が警察署を建てる
#POLICE_MAX=2             # 警察署の上限

# ── 配達員 / 倉庫 ──
#   倉庫に勤めている住民が配達員になり、荷物 (段ボール) を担いで各家庭の玄関へ運ぶ。
#   いまの状況は http://localhost:8080/delivery で見られる。
#   倉庫は日次でしか建たないので、すぐ試したいときは /city?force=warehouse
#DELIVERY=0               # 配達員を無効 (倉庫は建つが誰も運ばない)
#DELIV_FROM=9             # 配達を始めるゲーム内時刻
#DELIV_TO=17              # 配達を終える時刻
#DELIV_CREW=2             # 倉庫1軒あたりの配達員の人数
#DELIV_LOAD_SEC=3         # 倉庫での積み込みにかかる実時間 (秒)
#DELIV_DROP_SEC=3         # 玄関先に置くのにかかる実時間 (秒)
#DELIV_PARCEL_SEC=90      # 置かれた荷物が消えるまでの実時間 (住人が取り込む)
#DELIV_STUCK_SEC=90       # 着かないまま何秒たったら1巡を捨てるか
#WAREHOUSE_MIN_HOMES=4    # 住宅がこれだけ建ったら倉庫を建てはじめる
#WAREHOUSE_PER_POP=60     # 人口これごとに倉庫1軒まで
#WAREHOUSE_MAX=3          # 倉庫の上限
#PARCEL_CAP=96            # 同時に描ける荷物の数

# ── 建物の採算 / 学校 ──
#BANKRUPT=0               # 採算による閉鎖を無効
#OVERSIZE_PENALTY=3.0     # 街に対して大きすぎる建物の維持費倍率
#BANKRUPT_DAYS=5          # 赤字が続いて閉鎖するまでの日数
#WEEKEND_DAYS=2           # 7日のうち後ろ何日が休みか
#SCHOOL_FROM=8            # 通学の開始時刻
#SCHOOL_TO=15             # 通学の終了時刻
#ALLOWANCE=10             # 学生の仕送り (これが livingCost を下回ると子どもが困窮する)

# ── 見た目 ──
#TREE_GLB=./glb/tree.glb  # 木の3Dモデル。0 で従来の箱に戻す
#BLDG_GLB=./glb/building.glb  # ビルの3Dモデル。0 で従来のテクスチャ箱に戻す
#                             # 作り直しは node tools/make-building-glb.js
#BLDG_GLOW=1.0            # 夜の明るさの倍率。0 で全消灯 (夜も真っ暗な街)
#NIGHT_LIT=2.6            # ファサードの明かり (窓・のれん・店の看板) の強さ
#NIGHT_PCT=88             # テクスチャの上位何%を「明かり」とみなすか。下げると壁も光る
#NIGHT_AMB=0.10           # 明かり以外の面に薄く乗せる下駄。0 で夜のファサードが真っ黒に
#BLDG_BALCONY_MIN=3       # 何階建て以上にベランダを付けるか。0 で付けない
#GROUND_TEX=0             # 地面のテクスチャ(芝生/道路)を切って単色に戻す
#GRASS_TEX=./textures/base/grass_256.jpg     # 芝生。**2の冪サイズ必須** (WebGL1)
#ASPHALT_TEX=./textures/base/asphalt_256.jpg # 道路。同上
#GROUND_TILE=2.0          # 模様1枚ぶんのワールド長。既定=1セル。上げると模様が大きくなる
#VACANT_TEX=./textures/base/other_256.jpg    # 空き地(踏み固め/土)。同上
#GROUND_FILL=0.97         # 板1枚の大きさ(セル比)。1.0=隙間なし / 0.97 で格子状の線が出る
#LAMPS=0                  # 街灯を出さない
#LAMP_STEP=3              # 街灯を何セルおきに立てるか。上げると本数が減る
#LAMP_H=1.45              # 街灯の高さ (ワールド単位。1単位 ≒ 3.4m)
#LAMP_POOL=1.5            # 地面に落ちる光の輪の半径
#LAMP_GLOW=1.0            # 街灯の明るさの倍率。0 で消灯

# ── 影と太陽 ──
#SHADOWS=0                # 影を出さない (深度パスが1本減る)
#SHADOW_MAP=1024          # 影のテクスチャの一辺。塗り面積は辺の2乗で効く
#SHADOW_SOFT=1            # 縁のぼけた影 (PCFSoft)。フラグメントが重い
#SHADOW_SPAN=16           # 追跡ショットで影を落とす範囲の半径 (ワールド単位)
#SHADOW_BIAS=-0.0016      # 影のアクネ (縞) が出るときに調整
#SUN_ALT_MAX=48           # 南中高度(度)。**影の長さはほぼこれで決まる**。上げると影が短い
#SUN_AZ_OFF=34            # 太陽の軌道のねじれ(度)。0 だと正午に光がカメラの真後ろに来て影が隠れる
#SUN_MIN_ALT=14           # 光と影に使う最低高度(度)。日の出/日の入りで影が伸びきるのを防ぐ

# ── 空 / 露出 / 画角 ──
#EXPOSURE=0.78            # トーンマッピングの露出。下げると淡く、上げると締まる
#FOV=40                   # 追跡・俯瞰の画角(度)。60 は広角でゲームっぽく見える
#FPV_FOV=68               # 一人称だけは人の視野に合わせて広く
#CAM_LAG=3.2              # 追跡カメラが追いつく速さ。小さいほど遅れて「撮っている」感じ
#CAM_SHAKE=0.012          # 手持ちの揺れ幅 (セル比)。0 で完全に固定
#CHASE_CHANCE=0.5         # 一人称にならなかったとき「上空背後」を選ぶ割合。0 で従来の俯瞰寄りだけ
#CHASE_BACK=6.0           # 上空背後カメラの後方距離 (ワールド単位)
#CHASE_HIGH=7.6           # その高さ。いちばん高い建物 (6.60) より上に取ること
#CHASE_TURN=1.1           # 住民の向きへの追従の速さ。上げると曲がるたびに振り回される
#CHASE_AHEAD=0.55         # 視点を住民の何セル先に置くか (構図。上げると被写体が下がる)
#OCC_SIGHTLINE=0          # カメラと追跡中の住民の間にある建物を透かす処理を切る
#OCC_SIGHT_R=1.24         # その線から何ワールド単位まで拾うか

# ── 街のもの ──
#PROPS=0                  # 自販機・ガードレール・自転車・室外機・カーブミラーを出さない
#PROP_P=0.34              # 置ける場所のうち実際に置く割合
#WIRES=0                  # 電線を張らない
#WIRE_SAG=0.28            # 電線のたるみ (支間に対する比)
#WIRE_SPAN=8.7            # 結ぶ相手の距離の上限。既定は CELL*LAMP_STEP*1.45

# ── 建物 ──
#BLDG_SIDE_W=0.03         # 正面以外の面を無地の壁にする (既定 1 = 4面とも店の顔。窓が消えるほうが違和感が強かったので既定は無効)
#BLDG_SIDE_U0=0.015       # その帯の開始位置 (写真の左端から)
#BLDG_SIDE_DIM=0.94       # 側面・背面の暗さ (既定 1 = 落とさない)
#BLDG_H_VARY=0.12         # 建物ごとの高さのばらつき (±)。0 で同じ業種は全軒同じ高さ
#BLDG_H_STEPS=5           # 高さの段階数。増やすとジオメトリのキャッシュも増える
#BLDG_SETBACK=0.75        # 敷地の余白のうち何割を「通り側に寄せる」のに使うか。0 で中央
#PARTY_WALL=0             # 隣とくっつけない (従来どおり全部が独立した正方形になる)
#PLINTH_P=0.55            # 入り口の土間と植え込みを付ける割合
#BLDG_GRIME=0.26          # 建物の足元の汚しの濃さ。0 で新品のまま
#BLDG_GRIME_H=0.22        # 汚しが届く高さ (建物の高さに対する比)

# ── 濡れた路面 ──
#WET_WET_MIN=6            # 降り出してから濡れきるまで (分)
#WET_DRY_MIN=14           # 上がってから乾くまで (分)。0 に近いほど雨上がりが唐突

# ── 画質 ──
#SSAA=2                   # 何倍の解像度で描いて縮小するか。MSAA が使えないのでこれが唯一の AA
#WEATHER=sunny            # 天気を固定する (sunny|cloudy|rain)。見た目を詰めるとき用
#CRAB_DEBUG=1             # 体の向きと実際に進んだ向きのズレを測る (カニ歩きの検出)

# ── 治安の可視化 (ゴミ袋) ──
#LITTER=0                 # 治安が悪くてもゴミ袋を出さない
#LITTER_FULL=0.12         # 不穏度がこの値で「街じゅうゴミだらけ」。警察署が建つのは 0.03
#LITTER_MAX_P=0.55        # 最大でも道の何割にゴミを置くか
#LITTER_STEPS=8           # 荒れ具合の段階数 (地面の作り直し回数に効く)
#UNREST=0.12              # 不穏度を固定する (0..1)。治安が悪い街をその場で作れないので確認用

# ── 人口の増減 ──
#MOVEOUT=0                # 転出を無効にする (従来どおり人口は増える一方になる)
#MOVEOUT_MAX=6            # 1日に出ていく上限
#MOVEOUT_JOBLESS=6        # 何日無職なら出ていくか
#MOVEOUT_DESPER=0.75      # 追い詰められ度がこれ以上なら出ていく
#MOVEOUT_UNREST=0.6       # 不穏度に応じた上乗せ
#MOVEOUT_MIN_POP=6        # ここまでは減らさない
#MOVEOUT_VIEWER=0.25      # 視聴者の住民の出やすさ (0 で完全に対象外)
#MOVEIN_NOJOB=0.25        # 働き口が無い街への転入をどこまで絞るか
#MOVEIN_UNREST=0.10       # 不穏度がこの値になると転入が止まる
#EXPAND_STARVE=2          # 「建てたいのに置き場所が無い」が何日続いたら街を広げるか

# ── 景気の波 / 職場の撤退 ──
#BOOM=0                   # 景気の波を止める
#BOOM_DAYS=42             # 1周期の日数
#BOOM_AMP=0.35            # 振れ幅 (±)
#WORK_EXIT=0              # 職場の撤退イベントを止める
#WORK_EXIT_DAYS=25        # 最短の間隔(日)
#WORK_EXIT_P=0.35         # 間隔を過ぎた日に起きる確率
#WORK_EXIT_MIN=3          # 残す職場の数
#WORK_EXIT_SLACK=1.35     # 雇用の余力がこれ以上あるときだけ撤退させる

#FPV_CHANCE=0.25          # 一人称ショットになる確率。屋内の住民は選ばれない (壁しか映らない)

# ── 車 (traffic.js) ──
#CARS=0                   # 車を出さない
#CAR_MAX=18               # 同時に走る台数の上限
#CAR_SPEED=3.4            # 速度 (ワールド単位/秒。3.4 ≒ 40km/h)
#CAR_VIS=0.80             # 車体の見た目の倍率。1 で実寸の軽自動車 (3.30 x 1.46m)
#CAR_SPREAD=1.0           # 経路のばらけ具合。0 = 毎回いちばん短い道 (同じ幹線ばかり通る)
#CAR_LOCAL_P=0.35         # 発着点が街の中の行き止まりになる割合。0 = 通過交通だけ
#CAR_REROUTE=14           # 走行中に行き先を選び直す間隔(秒)。0 = 湧いたときの1本で走り切る
#CAR_SPAWN_SEC=0.7        # 湧かせる最短間隔(秒)。詰めると湧き口で団子になる
#CAR_TIME_GAP=0.42        # 車間。速度1あたり何秒ぶん余計に空けるか
#CAR_FADE_SEC=1.6         # 湧いてから見えきるまでの秒数 (0 でいきなり現れる)
#CAR_LIGHTS=0             # 前照灯 / 尾灯を出さない
#CAR_BEAM_LEN=4.8         # 路面を照らす光の長さ (ワールド単位)。既定は CELL*2.4
#CAR_BEAM_W=2.2           # その板の幅。既定は CELL*1.1
#CAR_BEAM_GLOW=1.0        # 路面の光の強さ。0 で灯具だけ光らせる
#CAR_NIGHT_FRAC=0.35      # 夜の交通量 (昼に対する割合)。1 で夜も減らさない

# ── 信号機 ──
#SIGNALS=0                # 信号を立てない
#SIGNAL_CYCLE=24          # 1周期(秒)。半分ずつを南北/東西に振る
#SIGNAL_YELLOW=3          # 黄の秒数
#SIGNAL_ALLRED=1.5        # 全赤の秒数
#SIGNAL_MIN_CLASS=2       # どの格の道が絡む交差点に立てるか (2=二車線 / 1=一通の辻にも立てる)

# ── 街の釣り合い ──
#ROAD_MAX_SHARE=0.50      # 道/(道+空き地) がこれを超えた日だけ、使われない道を空き地へ戻す
#ROAD_BACK_PER_DAY=3      # 1日に空き地へ戻す道の数 (CITY_TEMPO 倍される)
#ROAD_USE_DECAY=0.6       # 道の通行量の日次減衰。小さいほど「最近使われていない道」を早く拾う
#CLOSE_PER_DAY=2          # 1日に閉店させる上限 (CITY_TEMPO 倍される)
#MIN_PER_CAT=1            # 業種ごとに残す最低軒数。0 にすると業種ごと消える (churn が増える)
#CROWD_LOTS=10            # 空き区画がこれ以下なら「建て込んでいる」
#CROWD_CLOSE_X=2          # 建て込んでいる日の閉店枠の倍率
#VACANT_DAYS=2            # 空き家/空き職場を畳むまでの日数

# ── 人口の上限で街をリセット ──
#POP_MAX=100              # この人数に達したら祝ってから Day 1 で作り直す。0 で無効
#POP_MAX_SEC=14           # 祝いの画 (街全体の引き) を出す秒数
#POP_MAX_NEWMAP=1         # 次の街の地形も引き直す (既定は同じ地形で作り直し)
#NUM_AGENTS=1000          # 人数の上限 (人型のインスタンスと足跡バッファをこの数ぶん確保する)。
#                         # POP_MAX=100 で運用するなら 120 程度に下げるとメモリが浮く
#CAM_INTERVAL_MS=20000    # カメラのターゲット切替の間隔
#TREE_GLB_H=0.9           # 表示上の木の高さ (セル単位)
#LIGHT_KEY=1.0            # 平行光(陽射し)の強さ。上げるとコントラストが強くなる
#LIGHT_FILL=1.0           # 環境光(回り込み)の強さ。上げると眠い絵になる
#GROUND_AO=0              # 建物際の接地の陰影を切る
#AO_DEPTH=0.42            # 建物際をどこまで暗くするか
#SKY_DOME=0               # 空のグラデーションをやめて単色に戻す
#BLDG_TINT=0.10           # 建物ごとの色のばらつき

# ── 地平線とフォグ ──
#   フィールドの外に地面を敷いて、遠くを空の色に溶かす。負荷はほぼゼロ (+0.1ms)。
#FOG=0                    # フォグを切る
#FAR_GROUND=0             # 遠景の地面を敷かない (従来の「浮島」に戻る)
#FAR_COLOR=0x93ab74       # 遠景の土地の色
#FOG_NEAR_K=0.85          # 効き始め = GRID x CELL x これ (小さいほど手前から霞む)
#FOG_FAR_K=3.2            # 完全に溶ける距離 = GRID x CELL x これ

# ── 住民どうしの関係と立ち話 (social.js) ──
#SOCIAL=0                 # 無効にする
#TALK_P=0.35              # 立ち話になる確率
#TALK_SEC=4               # 立ち話の長さ (秒)
#TALK_MAX=6               # 同時に立ち話できる組数 (道を塞がないための上限)
#TALK_OPEN=0.45           # これより狭い場所では立ち止まらない
#REL_FRIEND=0.5           # 友人とみなす親密度
#FRIEND_NEWS_PER_DAY=3    # 友人成立を1日何件ティッカーに流すか
#MEET_SCAN=8              # 人混みで1tickに視界へ入れる人数 (負荷の上限)
#TALK_LOG=0               # 画面左下の会話ログを出さない
#TALK_LOG_LINES=6         # 覚えておく会話の数 (2〜12)
#TALK_LOG_ROWS=8          # 表示する行数 (折り返し後・3〜14)
#TALK_LOG_W=250           # 会話ログの幅 (px)。桁数はここから決まる
#TALK_LOG_FONT=10         # 会話ログの文字の大きさ (px)

# ── 街への自由な質問 (Gemini) ────────────────────────────────────────────
# 設定すると `!ask <質問>` と /ask?q= が街のことに答えるようになる。
# 空のままなら !ask は従来どおり住民名専用 (LLM を呼ばない)。
#   YT_API_KEY と同じ GCP プロジェクトなら同じキーでも動くが、
#   キーを差し替えたときに配信のチャット取得まで巻き添えで止まるので分けてある。
#   キーの API 制限をかけている場合は "Generative Language API" を許可すること。
GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash
#GEMINI_COOLDOWN_SEC=15
#GEMINI_USER_COOLDOWN_SEC=60
